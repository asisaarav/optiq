{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optiq",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  // Custom domain (code-optimizer.instaluxe.in) is bound separately once the
  // zone is Active on the account - see .github/workflows/deploy.yml. Binding it
  // here would fail the deploy while the domain is still on external nameservers.
}
