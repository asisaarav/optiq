{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optiq",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "code-optimizer.instaluxe.in",
      "custom_domain": true
    }
  ]
}
