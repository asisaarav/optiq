# ---- Supabase (auth + user profile storage) ----------------------------------
# Server-side
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose to the browser
# Client-side (Vite inlines VITE_* at build time - publishable key only)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- AI optimizer (server only) --------------------------------------------
# Any OpenAI-compatible provider. Examples:
#   OpenAI     : AI_BASE_URL=https://api.openai.com/v1                          AI_MODEL=gpt-4o-mini
#   Gemini     : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.5-flash
#   OpenRouter : AI_BASE_URL=https://openrouter.ai/api/v1                       AI_MODEL=google/gemini-2.5-flash
#   Groq       : AI_BASE_URL=https://api.groq.com/openai/v1                     AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
